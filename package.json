{
	"name": "nuxt-template-bootstrap",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "nuxt build",
		"dev": "dotenvx run --env NODE_OPTIONS=--enable-source-maps -- nuxt dev",
		"format": "prettier . --write",
		"generate": "nuxt generate",
		"postinstall": "nuxt prepare",
		"preview": "nuxt preview",
		"start": "node --env-file=.env .output/server/index.mjs"
	},
	"dependencies": {
		"@nuxt/eslint": "^1.7.1",
		"@nuxt/fonts": "^0.14.0",
		"@nuxt/icon": "^2.0.0",
		"@nuxtjs/color-mode": "^4.0.0",
		"bootstrap": "6.0.0-alpha.1",
		"maplibre-gl": "^6.4.0",
		"nuxt": "^4.4.6",
		"sass-embedded": "^1.89.2"
	},
	"devDependencies": {
		"@dotenvx/dotenvx": "^2.0.0",
		"@types/node": "^24.10.14",
		"eslint": "^10.0.2",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.6.2"
	},
	"allowScripts": {
		"@parcel/watcher@2.6.0": true,
		"esbuild@0.27.7": true,
		"esbuild@0.28.2": true,
		"unrs-resolver@1.12.2": true
	}
}
